APP_ENV=development
FLASK_DEBUG=true
SECRET_KEY=replace-with-a-long-random-secret
SERVER_HOST=127.0.0.1
PORT=5000
WEB_PORT=8000
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60

POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_PORT=5432
POSTGRES_DB=examcenterwebdb
POSTGRES_USER=examcenterwebsite
POSTGRES_PASSWORD=examcenterwebsitepassword
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}

AUTO_CREATE_DATABASE=true
TRUST_PROXY_HEADERS=false
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_NAME=examcenter-session
SESSION_LIFETIME_SECONDS=28800
ALLOW_ADMIN_REGISTRATION=true
HSTS_ENABLED=false
HSTS_MAX_AGE=31536000
CONTENT_SECURITY_POLICY=default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; object-src 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com

PRODUCT_NAME=Examcenter
COMPANY_NAME=Kings Tech Softwares
CONTACT_EMAIL=admin.examcenter@gmail.com
SUPPORT_HOURS=Mon-Fri, 8am-5pm WAT
SERVICE_NAME=Examcenter API
COPYRIGHT_YEAR=
SCHOOLS_JSON=[{"name":"Example Secondary School","location":"City, Country","students":"1,200+"}]
SCHOOLS_FILE=

INSTALLER_PATH=uploads
INSTALLER_FILENAME=examcenter-setup.exe
INSTALLER_EXTENSION=.exe
INSTALLER_ACCEPT=.exe,application/vnd.microsoft.portable-executable
UPLOAD_MAX_BYTES=524288000

SETUP_VIDEO_ID=
USAGE_VIDEO_ID=
YOUTUBE_EMBED_BASE_URL=https://www.youtube.com/embed


# Public licensing portal. Leave empty to keep Pro CTAs on the contact page.
LICENSE_PORTAL_URL=
PRICE_SIX_MONTHS=₦150,000
PRICE_ONE_YEAR=₦250,000
PRICE_TWO_YEARS=₦450,000
